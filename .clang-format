# Formatting rules for the Thermavip sources.
#
# This file was not chosen, it was measured on the existing tree: the column
# limit comes from a histogram of line widths (345 lines land exactly on column
# 200, one lands on 201), the indentation from the raw bytes of the sources
# (one tab per level, tab = 8 columns), and every brace and spacing rule below
# was read off the code rather than picked from a preset. Writing anything else
# here would turn the lint job red on code nobody had asked to change.
#
# The CI only checks the LINES a pull request modifies (see wf-lint.yml), never
# whole files: the tree has never been reformatted in one go, and a whole-file
# check would fail on the first commit touching a historical file.

Language: Cpp
BasedOnStyle: LLVM

ColumnLimit: 200
UseTab: Always
TabWidth: 8
IndentWidth: 8
ContinuationIndentWidth: 8
AccessModifierOffset: -8
NamespaceIndentation: All

# Allman for the declarations that own a scope, K&R for control flow:
#   void f()        namespace n        if (x) {
#   {               {                  }
#   }               }                  else {
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterStruct: true
  AfterUnion: true
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterExternBlock: true
  AfterControlStatement: Never
  AfterCaseLabel: false
  BeforeElse: true
  BeforeCatch: true
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

IndentCaseLabels: true
AllowShortCaseLabelsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Empty

PointerAlignment: Left
ReferenceAlignment: Pointer
DerivePointerAlignment: false

SpaceBeforeParens: ControlStatements
SpaceAfterTemplateKeyword: false
AlwaysBreakTemplateDeclarations: Yes
Cpp11BracedListStyle: false

# Include order is meaningful here and hand-maintained: several translation
# units rely on a header being seen before another. Reordering them silently
# would be a behaviour change disguised as formatting.
SortIncludes: false
IncludeBlocks: Preserve

AlignAfterOpenBracket: Align
AlignEscapedNewlines: Left
AlignTrailingComments: true
BinPackArguments: true
BinPackParameters: true
BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 8
FixNamespaceComments: false
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep: 2
ReflowComments: false
